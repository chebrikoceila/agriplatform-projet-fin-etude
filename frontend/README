│   │   ├── useNDVI.js                   # Hook fetch série NDVI
│   │   ├── useAlerts.js                 # Hook fetch alertes
│   │   └── useMap.js                    # Hook état carte (zoom, center)
│   │
│   ├── context/                         # 🌐 React Context (state global)
