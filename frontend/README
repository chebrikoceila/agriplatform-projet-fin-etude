# ============ CORE DEPENDENCIES ============

# Routing
npm install react-router-dom

# HTTP Client
npm install axios

# State Management (optionnel mais recommandé)
npm install @tanstack/react-query

# ============ MAP DEPENDENCIES ============

# Leaflet (cartes interactives)
npm install leaflet react-leaflet

# Dessin de polygones
npm install leaflet-draw
npm install @types/leaflet-draw  # Si TypeScript

# Alternative : Mapbox (payant mais plus beau)
# npm install mapbox-gl react-map-gl

# ============ CHARTS DEPENDENCIES ============

# Recharts (graphiques)
npm install recharts

# Alternative : Chart.js
# npm install react-chartjs-2 chart.js

# ============ UI/STYLING DEPENDENCIES ============

# Tailwind CSS
npm install -D tailwindcss postcss autoprefixer
npx tailwindcss init -p

# Icons
npm install lucide-react  # Icônes modernes

# Date manipulation
npm install date-fns

# Forms & Validation
npm install react-hook-form
npm install zod  # Schéma validation

# ============ UTILS ============

# GeoJSON manipulation
npm install @turf/turf

# PDF generation (côté client)
npm install jspdf  # Optionnel si backend génère PDF

# File download helper
npm install file-saver






